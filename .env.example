# Railway auto-injects this when you attach a Postgres plugin.
# For local dev, point it at a local/dev Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/crypto_portfolio

# Long random string used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Used only once, by `npm run migrate`, to create the first admin account.
# Change the password immediately after first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123
